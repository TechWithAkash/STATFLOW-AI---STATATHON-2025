# Root .gitignore

# Node
node_modules/
**/node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend builds (Vite)
dist/
**/dist/
.vite/
**/.vite/
.cache/

# Env files
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
.python-version
.venv/
venv/
ENV/

# Data/Storage
storage/
**/storage/
*.db
*.sqlite*
*.log
logs/

# OS/IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Build/coverage
coverage/
.coverage*
.pytest_cache/

# Misc
*.bak
*.tmp
*.cache
